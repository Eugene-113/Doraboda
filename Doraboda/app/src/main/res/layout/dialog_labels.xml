<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/labelPickerLinearLayout1"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            >
            <RadioGroup
                android:id="@+id/labelRadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:layout_marginTop="100dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="horizontal"
                >
                <RadioButton
                    android:id="@+id/labelRadioYellow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_radio_button_yellow"
                    android:button="@null"
                    android:layout_margin="20dp"
                    />
                <RadioButton
                    android:id="@+id/labelRadioLime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_radio_button_lime"
                    android:button="@null"
                    android:layout_margin="20dp"
                    />
                <RadioButton
                    android:id="@+id/labelRadioPink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_radio_button_pink"
                    android:button="@null"
                    android:layout_margin="20dp"
                    />
                <RadioButton
                    android:id="@+id/labelRadioSkyBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/selector_radio_button_skyblue"
                    android:button="@null"
                    android:layout_margin="20dp"
                    />
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            app:layout_constraintTop_toBottomOf="@+id/labelPickerLinearLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <Button
                android:id="@+id/labelsCancelButton"
                android:layout_weight="1"
                android:text="취소"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                />
            <Button
                android:id="@+id/labelsDoneButton"
                android:layout_weight="1"
                android:text="확인"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>