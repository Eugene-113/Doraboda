<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.DataFragment">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <ImageView
            android:id="@+id/dataImageView0"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/dataTextView1"
            android:text="@string/data2"
            android:textSize="30dp"
            android:textStyle="bold"
            android:layout_margin="10dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/dataImageView0"
            />
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_star"
            app:layout_constraintStart_toEndOf="@id/dataTextView1"
            app:layout_constraintTop_toTopOf="parent"
            />
        <TextView
            android:id="@+id/dataTextView2"
            android:textSize="25sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:layout_margin="10dp"
            app:layout_constraintTop_toBottomOf="@id/dataTextView1"
            app:layout_constraintStart_toStartOf="parent"
            />
        <com.github.mikephil.charting.charts.HorizontalBarChart
            android:id="@+id/dataBarChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/dataTextView2"
            android:layout_margin="30dp"
            />
        <ImageView
            android:id="@+id/dataBarChartImageView"
            android:src="@drawable/icon_quetionmark"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="@id/dataBarChart"
            app:layout_constraintBottom_toBottomOf="@id/dataBarChart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="30dp"
            />
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/dataPieChart"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:layout_constraintTop_toBottomOf="@id/dataBarChart"
            android:layout_margin="30dp"
            />
        <ImageView
            android:id="@+id/dataPieChartImageView"
            android:src="@drawable/icon_quetionmark"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintTop_toTopOf="@id/dataPieChart"
            app:layout_constraintBottom_toBottomOf="@id/dataPieChart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="30dp"
            android:visibility="invisible"
            />
        <ImageView
            android:id="@+id/dataImageView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            app:layout_constraintTop_toBottomOf="@id/dataPieChart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/dataTextView4"
            android:layout_margin="30dp"
            />
        <TextView
            android:id="@+id/dataTextView4"
            android:text="@string/data"
            android:textSize="30dp"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/dataPieChart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dataImageView"
            android:layout_margin="30dp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>